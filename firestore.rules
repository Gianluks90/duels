rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Amicizie (Qualità della vita): unica fonte di verità per "siamo amici" è l'esistenza di un
    // documento friendRequests/{a}_{b} con status=='accepted' — MAI un campo scrivibile sul profilo
    // stesso (es. un array friendIds), altrimenti chiunque potrebbe scriversi da solo l'accesso al
    // profilo di un altro senza che quello abbia mai accettato nulla. Le due direzioni (a_b e b_a)
    // vanno controllate entrambe: chi chiede la lettura potrebbe essere stato fromUid O toUid della
    // richiesta originale.
    function isAcceptedFriendRequest(a, b) {
      return exists(/databases/$(database)/documents/friendRequests/$(a + '_' + b)) &&
        get(/databases/$(database)/documents/friendRequests/$(a + '_' + b)).data.status == 'accepted';
    }
    function isFriend(otherUid) {
      return isAcceptedFriendRequest(request.auth.uid, otherUid) ||
        isAcceptedFriendRequest(otherUid, request.auth.uid);
    }

    // Dorsi carta (Riscatta codice): quali campi sono cambiati in QUESTA scrittura, per far restare
    // ogni funzione di validazione sotto un no-op quando non tocca quel campo (stesso spirito
    // difensivo del vecchio check su favoriteSpellIds, solo scomposto per campo).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Deve combaciare con public/config/card-backs.json — dorsi sempre selezionabili anche senza
    // possederli esplicitamente in unlockedCardBacks (profili creati prima di questa feature, o che
    // non hanno mai riscattato nulla).
    function freeCardBacks() {
      return ['dark', 'light'];
    }

    function cardBackValid() {
      return !changedKeys().hasAny(['cardBack']) ||
        request.resource.data.cardBack in
          freeCardBacks().toSet().union(resource.data.get('unlockedCardBacks', []).toSet());
    }

    function favoritesValid() {
      return !changedKeys().hasAny(['favoriteSpellIds']) ||
        request.resource.data.favoriteSpellIds.size() <= 5;
    }

    // Deve combaciare con public/config/backgrounds.json — i 4 sfondi esistenti oggi restano
    // sempre gratuiti (nessuno sblocco retroattivo per chi li usa già); solo gli sfondi aggiunti in
    // futuro come ricompensa (OBJECTIVE_CATALOG, data/objectives.ts) saranno gated da
    // unlockedBackgrounds. Stesso schema di freeCardBacks()/cardBackValid() sotto.
    function freeBackgrounds() {
      return ['dark-wood', 'light-wood', 'burn-wood', 'slate'];
    }

    function backgroundValid() {
      return !changedKeys().hasAny(['background']) ||
        request.resource.data.background in
          freeBackgrounds().toSet().union(resource.data.get('unlockedBackgrounds', []).toSet());
    }

    // Deve combaciare con le entry `unlock.kind === 'free'` di TITLE_CATALOG in data/titles.ts —
    // stesso schema di freeCardBacks()/freeBackgrounds() sopra. Gli altri titoli restano gated da
    // unlockedTitles come prima.
    function freeTitles() {
      return ['beginner'];
    }

    // "first_duelist" ("Primo duellante"/"Prima duellante") è `exclusive` a UN account (v.
    // data/titles.ts, EXCLUSIVE_TITLE_OWNER_UID — mirror manuale, le regole non possono importare
    // quel modulo): nessun altro uid deve poterselo equipaggiare, nemmeno passando la stessa
    // stringa letterale in `title`. Restituisce un array vuoto per chiunque altro, così
    // `in exclusiveTitles()` risulta sempre falso per loro.
    function exclusiveTitleOwnerUid() {
      return '8AkU1Du8BlNQYDKzH8Icu7lf8Qt2';
    }
    function exclusiveTitles() {
      return request.auth.uid == exclusiveTitleOwnerUid()
        ? ['first_duelist_m', 'first_duelist_f', 'first_duelist_x']
        : [];
    }

    function titleValid() {
      return !changedKeys().hasAny(['title']) ||
        request.resource.data.title in
          freeTitles().toSet().union(exclusiveTitles().toSet())
            .union(resource.data.get('unlockedTitles', []).toSet());
    }

    // Riscatto codice (AuthService.redeemCode): `lastRedeemedCode` è l'unico modo per la regola di
    // sapere QUALE codes/{CODICE} verificare — le regole non possono risalire al codice da un array
    // diff su unlockedCardBacks/redeemedCodeIds. Verifica lo stato FINALE del documento (il codice è
    // scaduto/non iniziato, è già in redeemedCodeIds, il cardBackId che sblocca è in
    // unlockedCardBacks) invece di provare a isolare "l'elemento appena aggiunto" agli array.
    //
    // hasAny(['lastRedeemedCode', 'unlockedCardBacks']) invece del solo lastRedeemedCode (fix
    // dell'audit 2026-07, mentre si chiudeva lo stesso gap per backgrounds/titles sotto): prima
    // nulla impediva a una scrittura che toccasse SOLO unlockedCardBacks — senza mai passare da
    // lastRedeemedCode — di infilarci un id arbitrario.
    //
    // Da quando anche i dorsi possono essere reward di obiettivi (ObjectiveRewardType 'cardBack'),
    // unlockedCardBacks ha DUE fonti legittime di crescita: il riscatto codice qui sotto, oppure un
    // riscatto obiettivo (claimGrantValid() più sotto, stesso file). Se lastRedeemedCode non è
    // cambiato, questa funzione si limita a controllare che sia comunque un riscatto obiettivo "in
    // forma" (claimedObjectiveIds cambiato anch'esso) — la validazione vera del contenuto
    // (monotonia, tetto di crescita) resta tutta in claimGrantValid(), non duplicata qui.
    function redeemValid() {
      return !changedKeys().hasAny(['lastRedeemedCode', 'unlockedCardBacks']) ||
        (changedKeys().hasAny(['lastRedeemedCode'])
          ? redeemGrantValid()
          : changedKeys().hasAny(['claimedObjectiveIds']));
    }

    function redeemGrantValid() {
      let code = request.resource.data.lastRedeemedCode;
      let codeRef = /databases/$(database)/documents/codes/$(code);
      // size() <= prior + 1 (fix dell'audit 2026-07): senza questo tetto, verificare solo che
      // l'id sbloccato dal codice SIA in unlockedCardBacks non impedirebbe di infilarcene un
      // secondo a piacere nella stessa scrittura — lo stesso schema già usato in claimGrantValid().
      return exists(codeRef) &&
        (get(codeRef).data.startAt == null || request.time >= get(codeRef).data.startAt) &&
        (get(codeRef).data.endAt == null || request.time <= get(codeRef).data.endAt) &&
        code in request.resource.data.get('redeemedCodeIds', []) &&
        get(codeRef).data.cardBackId in request.resource.data.get('unlockedCardBacks', []) &&
        request.resource.data.get('unlockedCardBacks', []).size() <=
          resource.data.get('unlockedCardBacks', []).size() + 1;
    }

    // Statistiche (Achievements): stesso schema del riscatto codice sopra — `lastStatsGameId` è
    // l'unico modo per la regola di sapere QUALE games/{gameId} verificare quando `stats` cambia.
    //
    // ATTENZIONE — rischio accettato consapevolmente (audit del 2026-07, stesso spirito di
    // password/visibility della lobby più sotto in questo file): `users/{userId}/countedGames/
    // {gameId}` (marker create-only, sotto) blocca il replay SOLO attraverso il client reale
    // (AuthService scrive sempre stats+marker insieme, quindi una volta creato il marker un secondo
    // tentativo dello stesso client viene respinto) — non è una garanzia crittografica: le regole
    // Firestore valutano ogni documento in modo indipendente, quindi non possono obbligare "questa
    // scrittura su users/{uid} è valida SOLO SE nella stessa richiesta viene creato anche il
    // marker". Un client scritto ad hoc potrebbe quindi omettere la creazione del marker e reinviare
    // l'update di stats per lo stesso gameId senza limite. Confinato al proprio account (nessuna
    // fuga di dati altrui), ricompense cosmetiche: una vera garanzia richiederebbe una Cloud
    // Function che aggreghi lo stats server-side quando games/{id} passa a 'finished'.
    //
    // Le regole non supportano comunque filtri/lambda su array: possono confrontare uno scalare
    // letto da games/{id} (qui `state.winner`), ma non contare quante voci di un certo tipo ci sono
    // in `state.eventLog`. Per questo partite giocate/vittorie/sconfitte sono le uniche validate
    // ESATTAMENTE; i contatori che nascerebbero contando l'eventLog (incantesimi lanciati,
    // combinazioni, danno, cura, carte raccolte) sono validati solo per PLAUSIBILITÀ (delta non
    // negativo, entro un tetto largo a partita, mai raggiungibile in una partita reale).
    // `spellCastCounts` (mappa libera per-incantesimo) non è validata nei valori, solo nella
    // dimensione (v. statsPlausible).
    function statsGameRef() {
      return /databases/$(database)/documents/games/$(request.resource.data.lastStatsGameId);
    }

    function statsGameData() {
      return get(statsGameRef()).data;
    }

    function statsRole() {
      return statsGameData().hostId == request.auth.uid ? 'host' : 'guest';
    }

    function priorStats() {
      return resource.data.get('stats', {
        gamesPlayed: 0, wins: 0, losses: 0, cardsCollected: 0, combinationsMade: 0,
        spellsCast: 0, spellCastCounts: {}, damageDealt: 0, healingDone: 0, currentWinStreak: 0,
        friendDuelsPlayed: 0, friendDuelWins: 0, shieldsGained: 0, shieldsRemoved: 0, manaConsumed: 0,
        freezeApplied: 0, poisonApplied: 0, cardPatternMatches: {}
      });
    }

    function statsDelta(field) {
      return request.resource.data.stats[field] - priorStats().get(field, 0);
    }

    // exists() prima di get() (a differenza della prima versione di questa regola): un
    // lastStatsGameId che punta a un documento inesistente non deve mai far valutare get() a vuoto.
    // Esclude anche il bot di debug (guestId 'debug-guest', sempre passivo — v. GameService.
    // createDebugGame): altrimenti si potrebbe farmare "vinci N duelli" battendolo a ripetizione.
    function isStatsGameParticipant() {
      return exists(statsGameRef()) &&
        statsGameData().status == 'finished' &&
        statsGameData().guestId != 'debug-guest' &&
        (statsGameData().hostId == request.auth.uid || statsGameData().guestId == request.auth.uid);
    }

    function statsNotYetCounted() {
      return !exists(
        /databases/$(database)/documents/users/$(resource.data.uid)/countedGames/$(request.resource.data.lastStatsGameId)
      );
    }

    function statsShapeValid() {
      return request.resource.data.stats is map &&
        request.resource.data.stats.gamesPlayed is int &&
        request.resource.data.stats.wins is int &&
        request.resource.data.stats.losses is int &&
        request.resource.data.stats.combinationsMade is int &&
        request.resource.data.stats.spellsCast is int &&
        request.resource.data.stats.cardsCollected is int &&
        request.resource.data.stats.damageDealt is int &&
        request.resource.data.stats.healingDone is int &&
        request.resource.data.stats.currentWinStreak is int &&
        request.resource.data.stats.friendDuelsPlayed is int &&
        request.resource.data.stats.friendDuelWins is int &&
        request.resource.data.stats.shieldsGained is int &&
        request.resource.data.stats.shieldsRemoved is int &&
        request.resource.data.stats.manaConsumed is int &&
        request.resource.data.stats.freezeApplied is int &&
        request.resource.data.stats.poisonApplied is int &&
        request.resource.data.stats.spellCastCounts is map &&
        request.resource.data.stats.spellCastCounts.size() <= 100 &&
        // cardPatternMatches (Achievements, es. "Che tutto vede", v. CARD_PATTERN_CATALOG in
        // data/card-patterns.ts): come spellCastCounts sopra, mappa libera non validata nei valori
        // (le regole non possono ricalcolare la composizione del mazzo finale), solo nella
        // dimensione — tetto largo apposta, il catalogo oggi ne ha 1.
        request.resource.data.stats.cardPatternMatches is map &&
        request.resource.data.stats.cardPatternMatches.size() <= 50;
    }

    // currentWinStreak (Achievements, "Inarrestabile"): a differenza degli altri campi qui sotto NON
    // è monotono (si azzera a una sconfitta) — ma è comunque derivabile ESATTAMENTE da `winner`
    // (stesso scalare già letto per wins/losses sopra), non da un conteggio sull'eventLog: +1 se
    // vinta, azzerato se persa, invariato in caso di pareggio (winner resta null, v. turn-engine.ts).
    function winStreakValid() {
      let won = statsGameData().state.winner == statsRole();
      let lost = statsGameData().state.winner != null && statsGameData().state.winner != statsRole();
      let next = request.resource.data.stats.currentWinStreak;
      let prior = priorStats().get('currentWinStreak', 0);
      return won ? next == prior + 1 : (lost ? next == 0 : next == prior);
    }

    // friendDuelsPlayed/friendDuelWins (Achievements, "Amichevole"/"Rivale"): come currentWinStreak
    // sopra, derivabili ESATTAMENTE da uno scalare letto da games/{id} — qui wasFriendDuel, lo
    // snapshot già validato al momento del join (v. "allow update" su games/{gameId} più sotto in
    // questo file, isFriend()) — non da un conteggio sull'eventLog.
    function friendDuelStatsValid() {
      let wasFriendDuel = statsGameData().wasFriendDuel;
      let won = statsGameData().state.winner == statsRole();
      return statsDelta('friendDuelsPlayed') == (wasFriendDuel ? 1 : 0) &&
        statsDelta('friendDuelWins') == (wasFriendDuel && won ? 1 : 0);
    }

    function statsPlausible() {
      let winner = statsGameData().state.winner;
      let role = statsRole();
      let won = winner == role;
      let lost = winner != null && winner != role;
      return statsDelta('gamesPlayed') == 1 &&
        statsDelta('wins') == (won ? 1 : 0) &&
        statsDelta('losses') == (lost ? 1 : 0) &&
        statsDelta('combinationsMade') >= 0 && statsDelta('combinationsMade') <= 50 &&
        statsDelta('spellsCast') >= 0 && statsDelta('spellsCast') <= 50 &&
        statsDelta('cardsCollected') >= 0 && statsDelta('cardsCollected') <= 200 &&
        statsDelta('damageDealt') >= 0 && statsDelta('damageDealt') <= 500 &&
        statsDelta('healingDone') >= 0 && statsDelta('healingDone') <= 200 &&
        statsDelta('shieldsGained') >= 0 && statsDelta('shieldsGained') <= 100 &&
        statsDelta('shieldsRemoved') >= 0 && statsDelta('shieldsRemoved') <= 200 &&
        statsDelta('freezeApplied') >= 0 && statsDelta('freezeApplied') <= 100 &&
        statsDelta('poisonApplied') >= 0 && statsDelta('poisonApplied') <= 100 &&
        // Tetto coerente con spellsCast sopra (max 50 lanci/partita) per il manaCost più alto del
        // catalogo (6, v. SPELL_CATALOG in data/spells.ts): 50 * 6 = 300.
        statsDelta('manaConsumed') >= 0 && statsDelta('manaConsumed') <= 300 &&
        winStreakValid() &&
        friendDuelStatsValid();
    }

    // completedObjectiveIds (AuthService.applyGameStats) può cambiare SOLO insieme a stats/
    // lastStatsGameId — mai da solo — ma a differenza di quei due può anche NON cambiare (una
    // partita che non completa nessun nuovo obiettivo scrive comunque lo stesso array di prima, non
    // rientra tra i changedKeys). Solo monotono (mai un id tolto) ed entro un tetto largo per
    // partita: non verifica che i NUOVI id corrispondano davvero a soglie raggiunte in
    // OBJECTIVE_CATALOG (richiederebbe incorporare l'intero catalogo nelle regole) — stesso rischio
    // accettato di statsPlausible() sopra.
    function completedObjectiveIdsValid() {
      let prior = resource.data.get('completedObjectiveIds', []);
      let next = request.resource.data.get('completedObjectiveIds', prior);
      // size() <= 200 (fix dell'audit 2026-07): il tetto "+20 a partita" da solo limita solo la
      // CRESCITA per singola scrittura, non impedirebbe all'array di gonfiarsi senza limite nel
      // tempo ripetendo l'azione su partite reali diverse — 200 è comunque un tetto largo apposta
      // (il catalogo oggi ne ha 14).
      return next.hasAll(prior) && next.size() <= prior.size() + 20 && next.size() <= 200;
    }

    // Achievements "Login 7 giorni consecutivi": lastLoginDate/loginStreak si aggiornano fuori dal
    // flusso di fine partita (AuthService.ensureUserProfile, ad ogni avvio app con un profilo già
    // esistente), quindi non possono passare da statsGameRef()/isStatsGameParticipant() sopra —
    // nessuna partita è coinvolta. Le regole non hanno un orologio server attendibile da confrontare
    // al calendario LOCALE del client (lastLoginDate è quello che il client stesso dichiara essere
    // "oggi") — stesso rischio accettato di statsPlausible() sopra, ricompensa cosmetica. Solo forma:
    // loginStreak cresce al massimo di 1 a scrittura, o si azzera (streak interrotto).
    function loginStreakValid() {
      return request.resource.data.lastLoginDate is string &&
        request.resource.data.loginStreak is int &&
        request.resource.data.loginStreak >= 0 &&
        request.resource.data.loginStreak <= resource.data.get('loginStreak', 0) + 1;
    }

    // Achievements "Istruito"/"Istruita": rulebookRead passa una sola volta da assente/false a true
    // (mai il contrario — stesso spirito "mai rimosso" di completedObjectiveIds).
    function rulebookReadValid() {
      return request.resource.data.rulebookRead == true;
    }

    // Achievements "Duellante socievole"/"Duellante amichevole": friendsCount è sincronizzato da
    // FriendsDialogComponent col numero di amicizie accettate REALMENTE lette in quel momento (v.
    // AuthService.syncFriendsCount) — a differenza di loginStreak non c'è un "+1 a scrittura" da
    // imporre (si può scoprire di aver guadagnato più amici insieme tra un'apertura e l'altra della
    // dialog), né un orologio server con cui confrontarlo: stesso rischio accettato di
    // statsPlausible() sopra, solo un tetto largo a prova di errori grossolani, non una prova che il
    // numero dichiarato sia quello vero.
    function friendsCountValid() {
      return request.resource.data.friendsCount is int &&
        request.resource.data.friendsCount >= 0 &&
        request.resource.data.friendsCount <= 500;
    }

    // I quattro "trigger" che possono far crescere completedObjectiveIds (partita conclusa, streak
    // di accessi, regolamento letto, amicizie sincronizzate) restano reciprocamente esclusivi in UNA
    // scrittura — ognuno richiede che i campi degli ALTRI non cambino nella stessa richiesta:
    // altrimenti una scrittura mista potrebbe portare con sé, ad esempio, un `loginStreak` arbitrario
    // "agganciato" a una scrittura di stats altrimenti valida, aggirando loginStreakValid() sopra.
    function gameStatsWrite() {
      return changedKeys().hasAll(['stats', 'lastStatsGameId']) &&
        !changedKeys().hasAny(['loginStreak', 'lastLoginDate', 'rulebookRead', 'friendsCount']) &&
        statsShapeValid() && isStatsGameParticipant() && statsNotYetCounted() && statsPlausible();
    }

    function loginStreakWrite() {
      return changedKeys().hasAll(['lastLoginDate', 'loginStreak']) &&
        !changedKeys().hasAny(['stats', 'lastStatsGameId', 'rulebookRead', 'friendsCount']) &&
        loginStreakValid();
    }

    function rulebookReadWrite() {
      return changedKeys().hasAny(['rulebookRead']) &&
        !changedKeys().hasAny(['stats', 'lastStatsGameId', 'loginStreak', 'lastLoginDate', 'friendsCount']) &&
        rulebookReadValid();
    }

    function friendsCountWrite() {
      return changedKeys().hasAny(['friendsCount']) &&
        !changedKeys().hasAny(['stats', 'lastStatsGameId', 'loginStreak', 'lastLoginDate', 'rulebookRead']) &&
        friendsCountValid();
    }

    function statsValid() {
      return !changedKeys().hasAny([
        'stats', 'lastStatsGameId', 'completedObjectiveIds',
        'loginStreak', 'lastLoginDate', 'rulebookRead', 'friendsCount'
      ]) ||
        ((gameStatsWrite() || loginStreakWrite() || rulebookReadWrite() || friendsCountWrite()) &&
         completedObjectiveIdsValid());
    }

    // Riscatto ricompensa obiettivo (AuthService.claimObjective): a differenza di stats sopra, qui
    // NON serve sapere quale partita — solo che l'obiettivo risulti già in completedObjectiveIds.
    // claimedObjectiveIds ⊆ completedObjectiveIds sempre, e unlockedCardBacks/unlockedBackgrounds/
    // unlockedTitles possono crescere solo insieme a un nuovo riscatto (mai da una scrittura
    // scollegata — chiude, anche per unlockedCardBacks, lo stesso gap già richiuso in redeemValid
    // per il riscatto codice). Un solo riscatto per scrittura — ma un obiettivo può dare più
    // ricompense insieme (Objective.rewards, v. data/objectives.ts), quindi PIÙ di questi tre array
    // possono crescere nella STESSA scrittura: ognuno è comunque gated indipendentemente da
    // `claimed` sotto, quindi resta corretto. Dorsi/sfondi ne aggiungono al massimo 1 a testa, i
    // titoli fino a 3 (le varianti di genere di uno stesso titolo, v. data/titles.ts). Non verifica
    // che gli id aggiunti siano PROPRIO i reward di QUELL'obiettivo (richiederebbe anche qui il
    // catalogo nelle regole) — stesso rischio accettato di statsPlausible() sopra.
    function claimValid() {
      return !changedKeys().hasAny([
        'claimedObjectiveIds', 'unlockedCardBacks', 'unlockedBackgrounds', 'unlockedTitles',
        'unlockedElementVariants'
      ]) || claimGrantValid();
    }

    function claimGrantValid() {
      let priorClaimed = resource.data.get('claimedObjectiveIds', []);
      let nextClaimed = request.resource.data.get('claimedObjectiveIds', priorClaimed);
      let completed = request.resource.data.get('completedObjectiveIds', []);
      let priorCardBacks = resource.data.get('unlockedCardBacks', []);
      let nextCardBacks = request.resource.data.get('unlockedCardBacks', priorCardBacks);
      let priorBackgrounds = resource.data.get('unlockedBackgrounds', []);
      let nextBackgrounds = request.resource.data.get('unlockedBackgrounds', priorBackgrounds);
      let priorTitles = resource.data.get('unlockedTitles', []);
      let nextTitles = request.resource.data.get('unlockedTitles', priorTitles);
      let priorElementVariants = resource.data.get('unlockedElementVariants', []);
      let nextElementVariants = request.resource.data.get('unlockedElementVariants', priorElementVariants);
      let claimed = nextClaimed.size() > priorClaimed.size();
      // A differenza di sfondi/titoli/varianti (una sola fonte legittima: il riscatto obiettivo), i
      // dorsi possono crescere anche via riscatto CODICE (lastRedeemedCode, v. redeemValid/
      // redeemGrantValid sopra) — quella scrittura non tocca mai claimedObjectiveIds, quindi qui
      // basta verificare che sia comunque un riscatto codice "in forma", la validazione vera del
      // contenuto resta in redeemGrantValid().
      let redeemedCode = changedKeys().hasAny(['lastRedeemedCode']);
      // I titoli sono l'unico reward che può aggiungere PIÙ di un id in un solo riscatto: le
      // varianti di genere (v. data/titles.ts, GENDERED_TITLE_IDS) — al massimo 3 (maschile/
      // femminile/neutro) per obiettivo. Dorsi/sfondi/varianti elemento restano a +1, un solo id per
      // riscatto. size() <= 200 su tutti e cinque (stesso fix applicato a
      // completedObjectiveIdsValid): il tetto di crescita per singola scrittura da solo non
      // impedirebbe a nessuno di questi array di gonfiarsi senza limite ripetendo il riscatto nel
      // tempo (claimedObjectiveIds può persino contenere duplicati di un id già completato e restare
      // comunque "+1 a scrittura" valido) — 200 è un tetto largo apposta, ben oltre qualunque
      // catalogo realistico (11 elementi collezionabili oggi, v. COLLECTIBLE_ELEMENT_IDS).
      return completed.hasAll(nextClaimed) &&
        nextClaimed.hasAll(priorClaimed) && nextClaimed.size() <= priorClaimed.size() + 1 &&
        nextClaimed.size() <= 200 &&
        nextCardBacks.hasAll(priorCardBacks) && nextCardBacks.size() <= priorCardBacks.size() + 1 &&
        nextCardBacks.size() <= 200 &&
        nextBackgrounds.hasAll(priorBackgrounds) && nextBackgrounds.size() <= priorBackgrounds.size() + 1 &&
        nextBackgrounds.size() <= 200 &&
        nextTitles.hasAll(priorTitles) && nextTitles.size() <= priorTitles.size() + 3 &&
        nextTitles.size() <= 200 &&
        nextElementVariants.hasAll(priorElementVariants) &&
        nextElementVariants.size() <= priorElementVariants.size() + 1 &&
        nextElementVariants.size() <= 200 &&
        // ogni array può crescere solo insieme al proprio riscatto legittimo — mai da una scrittura
        // scollegata.
        (nextCardBacks.size() == priorCardBacks.size() || claimed || redeemedCode) &&
        (nextBackgrounds.size() == priorBackgrounds.size() || claimed) &&
        (nextTitles.size() == priorTitles.size() || claimed) &&
        (nextElementVariants.size() == priorElementVariants.size() || claimed);
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isFriend(userId));
      allow write: if request.auth != null && request.auth.uid == userId &&
        favoritesValid() && cardBackValid() && redeemValid() && statsValid() &&
        backgroundValid() && titleValid() && claimValid();
    }

    // Achievements: marker create-only "questa partita è già stata conteggiata negli stats
    // dell'utente" — v. statsValid() sopra, incluso l'avviso sui limiti reali di questo guardiano
    // (blocca il replay solo attraverso il client reale, non è una garanzia crittografica).
    match /users/{userId}/countedGames/{gameId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId &&
        get(/databases/$(database)/documents/games/$(gameId)).data.status == 'finished' &&
        (get(/databases/$(database)/documents/games/$(gameId)).data.hostId == userId ||
         get(/databases/$(database)/documents/games/$(gameId)).data.guestId == userId);
      allow update, delete: if false;
    }

    // Riscatta codice: catalogo scritto solo manualmente (console/CLI Firebase) — mai dal client,
    // per questo `allow write: if false`. Solo `get` (non `list`), altrimenti chiunque potrebbe
    // enumerare l'intera collection e scoprire codici non ancora annunciati.
    match /codes/{codeId} {
      allow get: if request.auth != null;
      allow write: if false;
    }

    // Amicizie: richiesta/accettazione. requestId deterministico "{fromUid}_{toUid}" — vedi
    // FriendsService.sendRequest per il perché (dedup naturale, doppio-check facile sull'ID diretto).
    match /friendRequests/{requestId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);

      allow create: if request.auth != null &&
        requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending';

      // Due transizioni permesse: il destinatario accetta/rifiuta una richiesta pending; il mittente
      // può rimandarla dopo un rifiuto (declined -> pending). Un set() su un doc ESISTENTE è "update"
      // per le regole, non "create" — senza questa clausola un secondo tentativo dopo un rifiuto
      // sarebbe bloccato. fromUid/toUid restano sempre immutabili.
      allow update: if request.auth != null &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        (
          (request.auth.uid == resource.data.toUid && resource.data.status == 'pending' &&
           request.resource.data.status in ['accepted', 'declined']) ||
          (request.auth.uid == resource.data.fromUid && resource.data.status == 'declined' &&
           request.resource.data.status == 'pending')
        );

      // Cancellare il documento disamicizia entrambi insieme (un solo doc, non una entry per parte) —
      // sia mittente che destinatario possono farlo, sia per annullare una richiesta pending sia per
      // rimuovere un'amicizia accepted.
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    match /games/{gameId} {
      // 'waiting' (nessun guest ancora) leggibile da chiunque sia autenticato: serve a joinGame()
      // per verificare il codice stanza prima che il giocatore diventi guestId. Da 'setup' in poi
      // (stato di gioco presente, mani coperte incluse) solo host/guest della partita.
      allow read: if request.auth != null &&
        (resource.data.status == 'waiting' ||
         resource.data.hostId == request.auth.uid ||
         resource.data.guestId == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.guestId in [null, 'debug-guest'];

      allow update: if request.auth != null &&
        request.resource.data.hostId == resource.data.hostId && (
          // joinGame(): l'unico caso in cui chi scrive non è ancora host/guest della partita.
          // wasFriendDuel (Achievements "Amichevole"/"Rivale", v. user.model.ts) è validato QUI,
          // esattamente, riusando isFriend() sopra — a differenza del resto degli achievements non
          // c'è bisogno di accontentarsi di "plausibile": la vera fonte di verità (friendRequests)
          // è già leggibile dalle regole nello stesso momento in cui il join avviene.
          (resource.data.status == 'waiting' &&
           resource.data.guestId == null &&
           request.resource.data.guestId == request.auth.uid &&
           request.resource.data.wasFriendDuel == isFriend(resource.data.hostId)) ||
          (resource.data.hostId == request.auth.uid || resource.data.guestId == request.auth.uid)
        );

      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }
  }
}
