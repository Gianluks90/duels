rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Amicizie (Qualità della vita): unica fonte di verità per "siamo amici" è l'esistenza di un
    // documento friendRequests/{a}_{b} con status=='accepted' — MAI un campo scrivibile sul profilo
    // stesso (es. un array friendIds), altrimenti chiunque potrebbe scriversi da solo l'accesso al
    // profilo di un altro senza che quello abbia mai accettato nulla. Le due direzioni (a_b e b_a)
    // vanno controllate entrambe: chi chiede la lettura potrebbe essere stato fromUid O toUid della
    // richiesta originale.
    function isAcceptedFriendRequest(a, b) {
      return exists(/databases/$(database)/documents/friendRequests/$(a + '_' + b)) &&
        get(/databases/$(database)/documents/friendRequests/$(a + '_' + b)).data.status == 'accepted';
    }
    function isFriend(otherUid) {
      return isAcceptedFriendRequest(request.auth.uid, otherUid) ||
        isAcceptedFriendRequest(otherUid, request.auth.uid);
    }

    // Dorsi carta (Riscatta codice): quali campi sono cambiati in QUESTA scrittura, per far restare
    // ogni funzione di validazione sotto un no-op quando non tocca quel campo (stesso spirito
    // difensivo del vecchio check su favoriteSpellIds, solo scomposto per campo).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Deve combaciare con public/config/card-backs.json — dorsi sempre selezionabili anche senza
    // possederli esplicitamente in unlockedCardBacks (profili creati prima di questa feature, o che
    // non hanno mai riscattato nulla).
    function freeCardBacks() {
      return ['dark', 'light'];
    }

    function cardBackValid() {
      return !changedKeys().hasAny(['cardBack']) ||
        request.resource.data.cardBack in
          freeCardBacks().toSet().union(resource.data.get('unlockedCardBacks', []).toSet());
    }

    function favoritesValid() {
      return !changedKeys().hasAny(['favoriteSpellIds']) ||
        request.resource.data.favoriteSpellIds.size() <= 5;
    }

    // Riscatto codice (AuthService.redeemCode): `lastRedeemedCode` è l'unico modo per la regola di
    // sapere QUALE codes/{CODICE} verificare — le regole non possono risalire al codice da un array
    // diff su unlockedCardBacks/redeemedCodeIds. Verifica lo stato FINALE del documento (il codice è
    // scaduto/non iniziato, è già in redeemedCodeIds, il cardBackId che sblocca è in
    // unlockedCardBacks) invece di provare a isolare "l'elemento appena aggiunto" agli array.
    function redeemValid() {
      return !changedKeys().hasAny(['lastRedeemedCode']) || redeemGrantValid();
    }

    function redeemGrantValid() {
      let code = request.resource.data.lastRedeemedCode;
      let codeRef = /databases/$(database)/documents/codes/$(code);
      return exists(codeRef) &&
        (get(codeRef).data.startAt == null || request.time >= get(codeRef).data.startAt) &&
        (get(codeRef).data.endAt == null || request.time <= get(codeRef).data.endAt) &&
        code in request.resource.data.get('redeemedCodeIds', []) &&
        get(codeRef).data.cardBackId in request.resource.data.get('unlockedCardBacks', []);
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isFriend(userId));
      allow write: if request.auth != null && request.auth.uid == userId &&
        favoritesValid() && cardBackValid() && redeemValid();
    }

    // Riscatta codice: catalogo scritto solo manualmente (console/CLI Firebase) — mai dal client,
    // per questo `allow write: if false`. Solo `get` (non `list`), altrimenti chiunque potrebbe
    // enumerare l'intera collection e scoprire codici non ancora annunciati.
    match /codes/{codeId} {
      allow get: if request.auth != null;
      allow write: if false;
    }

    // Amicizie: richiesta/accettazione. requestId deterministico "{fromUid}_{toUid}" — vedi
    // FriendsService.sendRequest per il perché (dedup naturale, doppio-check facile sull'ID diretto).
    match /friendRequests/{requestId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);

      allow create: if request.auth != null &&
        requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending';

      // Due transizioni permesse: il destinatario accetta/rifiuta una richiesta pending; il mittente
      // può rimandarla dopo un rifiuto (declined -> pending). Un set() su un doc ESISTENTE è "update"
      // per le regole, non "create" — senza questa clausola un secondo tentativo dopo un rifiuto
      // sarebbe bloccato. fromUid/toUid restano sempre immutabili.
      allow update: if request.auth != null &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        (
          (request.auth.uid == resource.data.toUid && resource.data.status == 'pending' &&
           request.resource.data.status in ['accepted', 'declined']) ||
          (request.auth.uid == resource.data.fromUid && resource.data.status == 'declined' &&
           request.resource.data.status == 'pending')
        );

      // Cancellare il documento disamicizia entrambi insieme (un solo doc, non una entry per parte) —
      // sia mittente che destinatario possono farlo, sia per annullare una richiesta pending sia per
      // rimuovere un'amicizia accepted.
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    match /games/{gameId} {
      // 'waiting' (nessun guest ancora) leggibile da chiunque sia autenticato: serve a joinGame()
      // per verificare il codice stanza prima che il giocatore diventi guestId. Da 'setup' in poi
      // (stato di gioco presente, mani coperte incluse) solo host/guest della partita.
      allow read: if request.auth != null &&
        (resource.data.status == 'waiting' ||
         resource.data.hostId == request.auth.uid ||
         resource.data.guestId == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.guestId in [null, 'debug-guest'];

      allow update: if request.auth != null &&
        request.resource.data.hostId == resource.data.hostId && (
          // joinGame(): l'unico caso in cui chi scrive non è ancora host/guest della partita.
          (resource.data.status == 'waiting' &&
           resource.data.guestId == null &&
           request.resource.data.guestId == request.auth.uid) ||
          (resource.data.hostId == request.auth.uid || resource.data.guestId == request.auth.uid)
        );

      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }
  }
}
